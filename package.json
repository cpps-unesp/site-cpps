{
  "name": "site-cpps",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && astro check",
    "seed:check": "emdash seed seed/seed.json --validate",
    "ci": "npm run seed:check && astro sync && npm run typecheck && npm run lint && npm run build",
    "astro": "astro",
    "prepare": "[ -d .git ] && git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/react": "^7.0.1",
    "@emdash-cms/cloudflare": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.6",
    "daisyui": "^5.7.46",
    "emdash": "^1.1.0",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.3",
    "theme-change": "^3.0.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/node": "^25.9.8",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "wrangler": "^4.147.0"
  },
  "emdash": {
    "seed": "seed/seed.json"
  }
}
