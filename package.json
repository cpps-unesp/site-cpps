{
  "name": "site-cpps",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "tinacms dev -c \"astro dev\"",
    "build": "tinacms build && astro build && pagefind --site ./dist",
    "preview": "astro preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && astro check",
    "ci": "astro sync && npm run typecheck && npm run lint && npm run build",
    "astro": "astro",
    "prepare": "[ -d .git ] && git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/node": "^10.1.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tinacms/astro": "^0.7.0",
    "astro": "^6.4.8",
    "astro-pagefind": "^2.0.1",
    "daisyui": "^5.7.0",
    "marked": "^18.0.7",
    "sharp": "^0.35.3",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.3",
    "theme-change": "^3.0.4",
    "tinacms": "^3.13.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tinacms/cli": "^2.7.0",
    "@types/node": "^25.9.5",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "vite": "^7.3.2"
  }
}
