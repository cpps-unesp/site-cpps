---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Initiatives from '../../components/Initiatives.astro';
import NewsHomeSection from '../../components/NewsHomeSection.astro';
import QuemSomosResumo from '../../components/QuemSomosResumo.astro';
import { getTranslations } from '../../utils/i18n';
import type { SupportedLang } from '../../types/lang';

export function getStaticPaths() {
  return [{ params: { lang: 'pt' } }, { params: { lang: 'en' } }, { params: { lang: 'es' } }];
}

const currentLang = (Astro.params.lang ?? 'pt') as SupportedLang;
const locale = getTranslations(currentLang);

const { titulo, descricao } = locale;
---

<BaseLayout
  lang={currentLang}
  titulo={titulo}
  descricao={descricao}
  texts={locale.texts}
  identidade={locale.identidade}
  githubPath="src/pages/[lang]/index.astro"
>
  <Hero heroData={locale} lang={currentLang} />

  <QuemSomosResumo lang={currentLang} sobre={locale.sobre} />

  {locale.initiatives && <Initiatives initiatives={locale.initiatives} lang={currentLang} />}

  <NewsHomeSection lang={currentLang} />
</BaseLayout>
