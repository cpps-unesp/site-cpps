---
// Sob demanda: o hero vem do EmDash (Páginas > home).
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import AtividadesSection from '../../components/AtividadesSection.astro';
import ProdutosSection from '../../components/ProdutosSection.astro';
import FAQSection from '../../components/FAQSection.astro';
import NewsHomeSection from '../../components/NewsHomeSection.astro';
import { getAparencia } from '../../utils/aparencia';
import { getNoticiasDaHome } from '../../utils/noticias';
import { getTranslations } from '../../utils/i18n';
import { getHero } from '../../utils/conteudo';
import type { SupportedLang } from '../../types/lang';

const currentLang = (Astro.params.lang ?? 'pt') as SupportedLang;

const allowedLangs = ['pt', 'en', 'es'];
// Qualquer outro primeiro segmento (/xx/, /wp-login.php...) é 404, como no site
// estático: redirecionar fazia cada robô renderizar a home inteira.
if (!allowedLangs.includes(currentLang)) {
  return new Response(null, { status: 404 });
}

const locale = getTranslations(currentLang);
const [hero, aparencia] = await Promise.all([getHero(currentLang), getAparencia(currentLang)]);
// Aparência › Seções da página inicial: quais aparecem e em que ordem.
const secoes = aparencia.secoesHome;
const noticias = secoes.includes('noticias') ? await getNoticiasDaHome(currentLang) : [];

const { titulo, descricao, atividadesPesquisa, produtos } = locale;
---

<BaseLayout
  lang={currentLang}
  titulo={titulo}
  descricao={descricao}
  texts={locale.texts}
  identidade={locale.identidade}
  githubPath="src/pages/[lang]/index.astro"
>
  {secoes.map((secao) =>
    secao === 'hero' ? (
      <Hero heroData={{ hero }} lang={currentLang} aparencia={aparencia} />
    ) : (
      noticias.length > 0 && <NewsHomeSection lang={currentLang} noticias={noticias} />
    )
  )}

  {atividadesPesquisa && (
    <AtividadesSection
      id="atividades"
      title={atividadesPesquisa.title}
      description={atividadesPesquisa.description}
      image={hero.imagem}
      activities={atividadesPesquisa.items}
    />
  )}

  {produtos && (
    <ProdutosSection
      title={produtos.title}
      description={produtos.description}
      image={hero.imagem}
      produtos={produtos.items}
    />
  )}

  {locale.faqs && <FAQSection faqs={locale.faqs.items} />}
</BaseLayout>
