---
import routeTranslations from '../i18n/routeTranslations';
import type { SupportedLang } from '../types/lang';

interface Props {
  lang: SupportedLang;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  texts: any;
}

const { lang, texts } = Astro.props;
const h = texts.header ?? {};
const busca = texts.busca ?? {};
const pagina = (chave: string) => `/${lang}/${routeTranslations[chave][lang]}`;

// Coleções do EmDash que entram na busca e a página onde cada resultado aparece
// (`:slug` vira o slug da entrada).
const colecoes = {
  noticias: { rotulo: h.noticias, url: `${pagina('noticias')}/:slug` },
  equipe: { rotulo: h.equipe, url: pagina('institucional/equipe') },
  sobre: { rotulo: h.sobre, url: pagina('institucional/sobre') },
  documentos: { rotulo: h.documentos, url: pagina('institucional/documentos') },
  cafe_episodios: { rotulo: h.cafe, url: pagina('iniciativas/cafe-com-ciencia') },
  projetos: { rotulo: h.projetosDePesquisa, url: pagina('iniciativas/projetos-de-pesquisa') },
};

const config = {
  lang,
  colecoes,
  textos: { buscando: busca.buscando, semResultados: busca.semResultados },
};
---

<!-- ✅ Botão para abrir o modal
<label for="search-modal" class="btn">🔍 Buscar</label> --><!-- ✅ Modal DaisyUI -->
<input type="checkbox" id="search-modal" class="modal-toggle" />
<div class="modal" role="dialog" aria-modal="true" aria-labelledby="search-title">
  <div class="modal-box animate-scale-up glass-modal relative">
    <!-- ✅ Botão de fechar "X" -->
    <label for="search-modal" class="absolute top-3 right-3 cursor-pointer text-lg font-bold"
      >✖</label
    >

    <h3 id="search-title" class="text-primary mb-4 text-lg font-bold">{h.buscar}</h3>

    <!-- ✅ Busca no conteúdo do EmDash (/_emdash/api/search) -->
    <div class="search-wrapper" id="busca-site" data-config={JSON.stringify(config)}>
      <input
        type="search"
        id="busca-input"
        class="input input-bordered w-full"
        placeholder={busca.placeholder}
        aria-label={h.buscar}
        autocomplete="off"
      />
      <p id="busca-status" class="mt-3 text-sm opacity-70" aria-live="polite" hidden></p>
      <ul id="busca-resultados" class="mt-3 max-h-[60vh] space-y-2 overflow-y-auto"></ul>
    </div>

    <!-- ✅ Indicação com mesma cor do título -->
    <p class="text-primary mt-4 text-right text-sm font-semibold">{busca.fechar}</p>
  </div>
</div>

<script>
  type Colecao = { rotulo: string; url: string };
  type Config = {
    lang: string;
    colecoes: Record<string, Colecao>;
    textos: { buscando: string; semResultados: string };
  };
  type Resultado = {
    collection: string;
    id: string;
    slug: string | null;
    title?: string;
    snippet?: string;
  };

  const IDIOMA_PADRAO = 'pt';
  const MIN_CARACTERES = 2;

  // O EmDash tira o trecho do primeiro campo buscável, que aqui é sempre o
  // título: já vem escapado, só com <mark> em volta dos termos encontrados.
  function textoDoTrecho(html: string): string {
    const el = document.createElement('span');
    el.innerHTML = html;
    return el.textContent ?? '';
  }

  async function buscar(
    q: string,
    locale: string,
    colecoes: string[],
    signal: AbortSignal
  ): Promise<Resultado[]> {
    const params = new URLSearchParams({ q, locale, collections: colecoes.join(','), limit: '10' });
    const resposta = await fetch(`/_emdash/api/search?${params}`, { signal });
    if (!resposta.ok) throw new Error(`Busca falhou (${resposta.status})`);
    const corpo = await resposta.json();
    return corpo.data?.items ?? [];
  }

  function iniciarBusca() {
    const raiz = document.getElementById('busca-site');
    const input = document.getElementById('busca-input') as HTMLInputElement | null;
    const status = document.getElementById('busca-status');
    const lista = document.getElementById('busca-resultados');
    if (!raiz || !input || !status || !lista) return;

    const config: Config = JSON.parse(raiz.dataset.config ?? '{}');
    const nomes = Object.keys(config.colecoes);
    let timer: ReturnType<typeof setTimeout> | undefined;
    let controller: AbortController | null = null;

    function mostrarStatus(texto: string | null) {
      status!.hidden = !texto;
      status!.textContent = texto ?? '';
    }

    function mostrar(resultados: Resultado[]) {
      lista!.replaceChildren();
      mostrarStatus(resultados.length === 0 ? config.textos.semResultados : null);
      for (const r of resultados) {
        const colecao = config.colecoes[r.collection];
        if (!colecao) continue;
        const link = document.createElement('a');
        link.href = colecao.url.replace(':slug', encodeURIComponent(r.slug ?? r.id));
        link.className = 'hover:bg-base-200 block rounded-lg p-3 transition-colors';

        const rotulo = document.createElement('span');
        rotulo.className = 'text-primary text-xs font-bold tracking-wider uppercase';
        rotulo.textContent = colecao.rotulo;
        const titulo = document.createElement('span');
        titulo.className = 'block font-semibold';
        if (r.snippet && textoDoTrecho(r.snippet) === r.title) {
          titulo.innerHTML = r.snippet; // título com o termo destacado
        } else {
          titulo.textContent = r.title ?? '';
        }
        link.append(rotulo, titulo);

        const item = document.createElement('li');
        item.append(link);
        lista!.append(item);
      }
    }

    async function executar(q: string) {
      controller?.abort();
      controller = new AbortController();
      mostrarStatus(config.textos.buscando);
      try {
        const idiomas =
          config.lang === IDIOMA_PADRAO ? [IDIOMA_PADRAO] : [config.lang, IDIOMA_PADRAO];
        const listas = await Promise.all(
          idiomas.map((locale) => buscar(q, locale, nomes, controller!.signal))
        );
        // A versão no idioma da página vem primeiro; sem tradução, entra a de pt.
        const vistos = new Set<string>();
        const resultados = listas.flat().filter((r) => {
          const chave = `${r.collection}:${r.slug ?? r.id}`;
          if (vistos.has(chave)) return false;
          vistos.add(chave);
          return true;
        });
        mostrar(resultados);
      } catch (erro) {
        if ((erro as Error).name === 'AbortError') return;
        console.error(erro);
        mostrar([]);
      }
    }

    input.addEventListener('input', () => {
      clearTimeout(timer);
      const q = input.value.trim();
      if (q.length < MIN_CARACTERES) {
        controller?.abort();
        lista.replaceChildren();
        mostrarStatus(null);
        return;
      }
      timer = setTimeout(() => executar(q), 250);
    });
  }

  iniciarBusca();

  document.addEventListener('keydown', (e) => {
    const modalToggle = document.getElementById('search-modal') as HTMLInputElement | null;
    if (modalToggle && e.key === 'Escape' && modalToggle.checked) {
      modalToggle.checked = false;
    }
  });

  const modalToggle = document.getElementById('search-modal') as HTMLInputElement | null;
  if (modalToggle) {
    modalToggle.addEventListener('change', () => {
      if (modalToggle.checked) {
        setTimeout(() => document.getElementById('busca-input')?.focus(), 100);
      }
    });
  }
</script>

<style is:global>
  @keyframes scale-up {
    0% {
      transform: scale(0.95);
      opacity: 0;
    }
    100% {
      transform: scale(1);
      opacity: 1;
    }
  }
  .animate-scale-up {
    animation: scale-up 0.2s ease-out;
  }
  .glass-modal {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    border-radius: 1rem;
  }

  .search-wrapper {
    background: rgba(255, 255, 255, 0.6); /* ✅ Branco translúcido */
    backdrop-filter: blur(8px);
    padding: 0.75rem;
    border-radius: 0.5rem;
  }

  .search-wrapper input {
    background: rgba(255, 255, 255, 0.8); /* ✅ Branco mais sólido mas ainda translúcido */
    backdrop-filter: blur(4px);
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .search-wrapper mark {
    background: transparent;
    color: var(--color-primary);
  }
</style>
