---
import NoticiaCard from './NoticiaCard.astro';
import type { SupportedLang } from '../types/lang';
import { getNoticiaUrl, type Noticia } from '../utils/noticias';

interface Props {
  noticias: Noticia[];
  lang: SupportedLang;
}

const { noticias, lang } = Astro.props;
---

<div id="news-grid" class="grid gap-8 md:grid-cols-2">
  {
    noticias.map((post) => (
      <NoticiaCard
        title={post.title}
        resumo={post.resumo}
        image={post.image}
        imageAlt={post.imageAlt}
        tags={post.tags}
        slug={getNoticiaUrl(post.slug, lang)}
        lang={lang}
        date={post.date}
        author={post.author}
      />
    ))
  }
</div>
