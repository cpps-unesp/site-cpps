---
import NoticiaCard from './NoticiaCard.astro';
import type { CollectionEntry } from 'astro:content';
import type { SupportedLang } from '../types/lang';
import { getNoticiaUrl } from '../utils/noticiaSlug';

interface Props {
  noticias: CollectionEntry<'noticias'>[];
  lang: SupportedLang;
}

const { noticias, lang } = Astro.props;
---

<div id="news-grid" class="grid gap-8 md:grid-cols-2">
  {
    noticias.map((post) => (
      <NoticiaCard
        title={post.data.title}
        resumo={post.data.resumo}
        image={post.data.image}
        tags={post.data.tags}
        slug={getNoticiaUrl(post, lang)}
        lang={lang}
        date={post.data.date}
        author={post.data.author}
      />
    ))
  }
</div>
