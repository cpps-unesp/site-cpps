---
import { Image } from 'emdash/ui';
import type { SupportedLang } from '../types/lang';
import { getTranslations } from '../utils/i18n';
import { formatNoticiaDate, getNoticiaUrl, type Noticia } from '../utils/noticias';

interface Props {
  post: Noticia;
  lang: SupportedLang;
}

const { post, lang } = Astro.props;
const locale = getTranslations(lang);
const { title, resumo, image, imageAlt, tags, date, author } = post;
// Edição visual: só para notícias no idioma da página.
const edit = post.lang === lang ? post.edit : undefined;
const slug = getNoticiaUrl(post.slug, lang);
---

<div class="group bg-base-100 relative mb-12 overflow-hidden rounded-2xl shadow-xl">
  <div class="grid gap-0 md:grid-cols-2">
    <div {...edit?.image} class="relative h-64 overflow-hidden md:h-auto">
      <Image
        image={image}
        alt={imageAlt}
        priority
        class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    </div>
    <div class="bg-primary text-primary-content flex flex-col justify-center p-8 md:p-12">
      <div class="mb-4 flex flex-wrap gap-2">
        {
          tags.map((tag) => (
            <span class="rounded bg-white/20 px-2 py-1 text-xs font-bold tracking-wider uppercase">
              {tag.label}
            </span>
          ))
        }
      </div>

      <a href={slug} class="hover:underline">
        <h2 {...edit?.title} class="mb-4 text-3xl leading-tight font-bold md:text-5xl">
          {title}
        </h2>
      </a>

      <p {...edit?.resumo} class="mb-6 line-clamp-3 text-lg opacity-90">
        {resumo}
      </p>

      <div class="flex items-center gap-4 text-sm font-medium opacity-80">
        <span>{formatNoticiaDate(date, lang)}</span>
        <>
          <span class="h-1 w-1 rounded-full bg-current" />
          <span>
            {locale.noticias?.by || 'Por'} {author}
          </span>
        </>
      </div>
    </div>
  </div>
</div>
