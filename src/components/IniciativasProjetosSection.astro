---
import { tinaField } from '@tinacms/astro/tina-field';
import { normalizeLang, type Localized } from '../lib/tina/pages';

type Card = {
  titulo: Localized;
  descricao: Localized;
  link: Localized;
};

interface Props {
  data: { titulo?: Localized; descricao?: Localized; cards?: Card[] } | null | undefined;
  lang?: string;
}

const { data, lang: langProp } = Astro.props;
const lang = normalizeLang(langProp ?? 'pt');
const cards: Card[] = data?.cards ?? [];
---

<section class="mx-auto max-w-6xl space-y-12 px-4 py-16">
  <h1
    class="text-primary text-3xl font-bold"
    data-tina-field={(data?.titulo && tinaField(data.titulo, lang)) || undefined}
  >
    {data?.titulo?.[lang] ?? 'Projetos'}
  </h1>
  <p
    class="text-base-content"
    data-tina-field={(data?.descricao && tinaField(data.descricao, lang)) || undefined}
  >
    {
      data?.descricao?.[lang] ??
        'Conheça os projetos desenvolvidos pelo CPPS nas áreas de pesquisa e dados aplicados às ciências sociais e humanas.'
    }
  </p>

  <div class="grid gap-8 md:grid-cols-2">
    {
      cards.map((card) => (
        <div class="border-base-300 bg-base-100 rounded-xl border p-6 shadow-sm transition hover:shadow">
          <h2
            class="mb-2 text-xl font-semibold"
            data-tina-field={tinaField(card.titulo, lang) || undefined}
          >
            {card.titulo[lang]}
          </h2>
          <p
            class="text-base-content mb-4"
            data-tina-field={tinaField(card.descricao, lang) || undefined}
          >
            {card.descricao[lang]}
          </p>
          <a
            class="btn btn-sm btn-primary"
            href={card.link[lang]}
            data-tina-field={tinaField(card.link, lang) || undefined}
          >
            Ver mais
          </a>
        </div>
      ))
    }
  </div>
</section>
