---
import { tinaField } from '@tinacms/astro/tina-field';

type Card = {
  titulo: string;
  descricao: string;
  link: string;
};

interface Props {
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  data: any;
}

const { data } = Astro.props;
const cards: Card[] = data?.cards ?? [];
---

<section class="mx-auto max-w-6xl space-y-12 px-4 py-16">
  <h1
    class="text-primary text-3xl font-bold"
    data-tina-field={tinaField(data, 'titulo') || undefined}
  >
    {data?.titulo ?? 'Projetos'}
  </h1>
  <p
    class="text-base-content"
    data-tina-field={tinaField(data, 'descricao') || undefined}
  >
    {
      data?.descricao ??
        'Conheça os projetos desenvolvidos pelo CPPS nas áreas de pesquisa e dados aplicados às ciências sociais e humanas.'
    }
  </p>

  <div class="grid gap-8 md:grid-cols-2">
    {
      cards.map((card) => (
        <div class="border-base-300 bg-base-100 rounded-xl border p-6 shadow-sm transition hover:shadow">
          <h2
            class="mb-2 text-xl font-semibold"
            data-tina-field={tinaField(card, 'titulo') || undefined}
          >
            {card.titulo}
          </h2>
          <p
            class="text-base-content mb-4"
            data-tina-field={tinaField(card, 'descricao') || undefined}
          >
            {card.descricao}
          </p>
          <a
            class="btn btn-sm btn-primary"
            href={card.link}
            data-tina-field={tinaField(card, 'link') || undefined}
          >
            Ver mais
          </a>
        </div>
      ))
    }
  </div>
</section>
