---
type Localized = { pt: string; en: string; es: string };

type DocumentoFormato = {
  tipo: string;
  url: string;
};

type DocumentoArquivo = {
  nome: Localized;
  formatos: DocumentoFormato[];
};

type DocumentoGrupo = {
  titulo: Localized;
  descricao: Localized;
  arquivos: DocumentoArquivo[];
};

import { tinaField } from '@tinacms/astro/tina-field';
import { normalizeLang } from '../lib/tina/pages';

type DocumentosData = {
  titulo: Localized;
  descricao: Localized;
  grupos: DocumentoGrupo[];
};

const { documentos, lang: langProp } = Astro.props as { documentos: DocumentosData; lang?: string };
const lang = normalizeLang(langProp ?? 'pt');

function buildUrl(url?: string) {
  if (!url || url.startsWith('http')) return url;
  if (url.startsWith(`/${lang}/`) || url === `/${lang}`) return url;
  if (url.startsWith('/')) return `/${lang}${url}`;
  return `/${lang}/${url}`;
}
---

<section class="mx-auto mt-16 mb-32 max-w-7xl space-y-12 px-4 md:px-8 lg:px-16">
  <h1
    class="titulo text-primary mb-8 text-center"
    data-tina-field={tinaField(documentos.titulo, lang) || undefined}
  >
    {documentos.titulo[lang]}
  </h1>
  <p
    class="paragrafo mb-16 text-center"
    data-tina-field={tinaField(documentos.descricao, lang) || undefined}
  >
    {documentos.descricao[lang]}
  </p>

  <div class="flex flex-wrap justify-center gap-10">
    {
      documentos.grupos.map((grupo: DocumentoGrupo) => (
        <div class="bg-base-100 flex w-[28rem] flex-col gap-4 rounded-xl p-8 shadow-md">
          <h2
            class="mb-2 text-2xl font-semibold"
            data-tina-field={tinaField(grupo.titulo, lang) || undefined}
          >
            {grupo.titulo[lang]}
          </h2>
          <p
            class="paragrafo text-sm"
            data-tina-field={tinaField(grupo.descricao, lang) || undefined}
          >
            {grupo.descricao[lang]}
          </p>

          <ul class="mt-4 space-y-3">
            {grupo.arquivos.map((arquivo: DocumentoArquivo) => (
              <li>
                <div
                  class="font-semibold"
                  data-tina-field={tinaField(arquivo.nome, lang) || undefined}
                >
                  {arquivo.nome[lang]}
                </div>
                <div class="mt-1 flex flex-wrap gap-2">
                  {arquivo.formatos.map((formato: DocumentoFormato) => (
                    <a
                      href={buildUrl(formato.url)}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn btn-sm btn-outline"
                      data-tina-field={tinaField(formato, 'tipo') || undefined}
                    >
                      {formato.tipo}
                    </a>
                  ))}
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
