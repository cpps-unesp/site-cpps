---
import { tinaField } from '@tinacms/astro/tina-field';

interface Props {
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  data: any;
}

const { data } = Astro.props;
---

<section class="mx-auto max-w-4xl space-y-6 px-4 py-16">
  <h1
    class="text-primary text-3xl font-bold"
    data-tina-field={tinaField(data, 'titulo') || undefined}
  >
    {data?.titulo ?? 'Cooperação e Parcerias'}
  </h1>
  <p
    class="text-base-content"
    data-tina-field={tinaField(data, 'descricao') || undefined}
  >
    {
      data?.descricao ??
        'Descubra as instituições, redes e grupos com os quais o CPPS colabora para ampliar o impacto das suas iniciativas.'
    }
  </p>
</section>
