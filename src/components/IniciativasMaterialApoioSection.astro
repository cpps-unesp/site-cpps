---
import { tinaField } from '@tinacms/astro/tina-field';
import { normalizeLang, type Localized } from '../lib/tina/pages';

interface Props {
  data: { titulo?: Localized; descricao?: Localized } | null | undefined;
  lang?: string;
}

const { data, lang: langProp } = Astro.props;
const lang = normalizeLang(langProp ?? 'pt');
---

<section class="mx-auto max-w-4xl space-y-6 px-4 py-16">
  <h1
    class="text-primary text-3xl font-bold"
    data-tina-field={(data?.titulo && tinaField(data.titulo, lang)) || undefined}
  >
    {data?.titulo?.[lang] ?? 'Material de Apoio'}
  </h1>
  <p
    class="text-base-content"
    data-tina-field={(data?.descricao && tinaField(data.descricao, lang)) || undefined}
  >
    {
      data?.descricao?.[lang] ??
        'Recursos, apostilas e documentos didáticos disponibilizados pelo CPPS para formação e apoio a pesquisadores.'
    }
  </p>
</section>
