---
import { tinaField } from '@tinacms/astro/tina-field';
import { normalizeLang, type Localized } from '../lib/tina/pages';

interface Props {
  data: { titulo?: Localized; descricao?: Localized } | null | undefined;
  lang?: string;
}

const { data, lang: langProp } = Astro.props;
const lang = normalizeLang(langProp ?? 'pt');
---

<div class="mb-8 text-center">
  <h1
    class="text-primary mb-4 text-4xl font-bold"
    data-tina-field={(data?.titulo && tinaField(data.titulo, lang)) || undefined}
  >
    {data?.titulo?.[lang] ?? 'Projetos de Pesquisa'}
  </h1>
  <p
    class="text-base-content mx-auto max-w-3xl text-lg"
    data-tina-field={(data?.descricao && tinaField(data.descricao, lang)) || undefined}
  >
    {data?.descricao?.[lang] ?? 'Projetos desenvolvidos por docentes e associados ao CPPS.'}
  </p>
</div>
