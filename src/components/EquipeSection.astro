---
import { ordenarPorPrioridadeOuNome } from '../utils/ordenar';
import EquipeTabs from '../components/EquipeTabs.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import ParagrafoIntroEquipe from './tina/ParagrafoIntroEquipe.astro';
import QuebraResponsiva from './tina/QuebraResponsiva.astro';
import { normalizeLang, type Localized } from '../lib/tina/pages';

interface Membro {
  nome: string;
  status?: string;
  prioridade?: number | string;
  slug?: string;
  foto?: string;
  cargo?: Localized;
  descricao?: Localized;
  contribuicao?: Localized;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  redes?: any[];
  [key: string]: unknown;
}

type EquipeData = {
  title: Localized;
  intro?: Localized;
  categorias?: Record<string, Membro[]>;
}

interface Props {
  equipe: EquipeData;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  texts: any;
  lang?: string;
  membroSlugs?: string[];
}

const { equipe, texts } = Astro.props;
const lang = normalizeLang(Astro.props.lang ?? Astro.params.lang ?? 'pt');

// Organiza os membros ativos por categoria
const ativosPorCategoria = Object.entries((equipe.categorias as Record<string, Membro[]>) ?? {}).map(
  ([categoria, membros]) => [
    categoria,
    ordenarPorPrioridadeOuNome(
      membros.filter((m: Membro) => m.status !== 'inativo'),
      'prioridade',
      'nome',
      'asc'
    ),
  ]
);

// Coleta e ordena todos os membros inativos
const inativosTodos = Object.values((equipe.categorias as Record<string, Membro[]>) ?? {})
  .flat()
  .filter((m: Membro) => m.status === 'inativo');

const inativosOrdenados = ordenarPorPrioridadeOuNome(inativosTodos, 'prioridade', 'nome', 'asc');
---

<section class="mx-auto mt-16 max-w-screen-xl px-4 md:px-8">
  <h1 class="titulo text-primary mb-8 text-center" data-tina-field={tinaField(equipe.title, lang) || undefined}>{equipe.title[lang]}</h1>

  {
    equipe.intro && (
      <div
        class="text-base-content mx-auto mb-10 max-w-3xl space-y-4 text-center"
        data-tina-field={tinaField(equipe.intro, lang) || undefined}
      >
        <TinaMarkdown
          content={equipe.intro[lang]}
          components={{ p: ParagrafoIntroEquipe, break: QuebraResponsiva }}
        />
      </div>
    )
  }

  <!-- Tabs com layout unificado usando componente padrão do DaisyUI -->
  <EquipeTabs
    ativos={ativosPorCategoria}
    inativos={inativosOrdenados}
    lang={lang}
    layout="pesquisador"
    texts={texts}
    membroSlugs={Astro.props.membroSlugs}
  />
</section>
