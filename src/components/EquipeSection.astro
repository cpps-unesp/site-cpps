---
import { ordenarPorPrioridadeOuNome } from '../utils/ordenar';
import EquipeTabs from '../components/EquipeTabs.astro';
import { tinaField } from '@tinacms/astro/tina-field';

interface Membro {
  nome: string;
  status?: string;
  prioridade?: number | string;
  slug?: string;
  foto?: string;
  cargo?: string;
  descricao?: string;
  contribuicao?: string;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  redes?: any[];
  [key: string]: unknown;
}

type EquipeData = {
  title: string;
  intro?: string[];
  categorias?: Record<string, Membro[]>;
}

interface Props {
  equipe: EquipeData;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  texts: any;
  lang?: string;
  membroSlugs?: string[];
}

const { equipe, texts } = Astro.props;
const lang = Astro.props.lang ?? Astro.params.lang ?? 'pt';

// Organiza os membros ativos por categoria
const ativosPorCategoria = Object.entries((equipe.categorias as Record<string, Membro[]>) ?? {}).map(
  ([categoria, membros]) => [
    categoria,
    ordenarPorPrioridadeOuNome(
      membros.filter((m: Membro) => m.status !== 'inativo'),
      'prioridade',
      'nome',
      'asc'
    ),
  ]
);

// Coleta e ordena todos os membros inativos
const inativosTodos = Object.values((equipe.categorias as Record<string, Membro[]>) ?? {})
  .flat()
  .filter((m: Membro) => m.status === 'inativo');

const inativosOrdenados = ordenarPorPrioridadeOuNome(inativosTodos, 'prioridade', 'nome', 'asc');
---

<section class="mx-auto mt-16 max-w-screen-xl px-4 md:px-8">
  <h1 class="titulo text-primary mb-8 text-center" data-tina-field={tinaField(equipe, 'title') || undefined}>{equipe.title}</h1>

  {
    equipe.intro && equipe.intro.length > 0 && (
      <div class="text-base-content mx-auto mb-10 max-w-3xl space-y-4 text-center">
        {equipe.intro.map((paragrafo: string, introIdx: number) => (
          <p class="paragrafo [&>a]:text-primary hover:[&>a]:text-secondary text-[clamp(0.95rem,1vw+0.2rem,1.125rem)] leading-relaxed transition [&>a]:underline" data-tina-field={tinaField(equipe, 'intro', introIdx) || undefined}>
            {/* eslint-disable-next-line astro/no-set-html-directive */}
            <Fragment set:html={paragrafo} />
          </p>
        ))}
      </div>
    )
  }

  <!-- Tabs com layout unificado usando componente padrão do DaisyUI -->
  <EquipeTabs
    ativos={ativosPorCategoria}
    inativos={inativosOrdenados}
    lang={lang}
    layout="pesquisador"
    texts={texts}
    membroSlugs={Astro.props.membroSlugs}
  />
</section>
