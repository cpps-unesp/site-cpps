---
import { Image, PortableText } from 'emdash/ui';
import BaseLayout from '../layouts/BaseLayout.astro';
import FaseTesteAlert from './FaseTesteAlert.astro';
import NewsSidebar from './NewsSidebar.astro';
import TranslationWarning from './TranslationWarning.astro';
import type { SupportedLang } from '../types/lang';
import { getTranslations } from '../utils/i18n';
import { formatNoticiaDate, getNoticiaCategoriaUrl, type Noticia } from '../utils/noticias';

interface Props {
  lang: SupportedLang;
  noticia: Noticia;
  // Notícias do idioma da página, para a barra lateral.
  noticiasDoIdioma: Noticia[];
  isPreview?: boolean;
}

const { lang, noticia, noticiasDoIdioma, isPreview = false } = Astro.props;
const locale = getTranslations(lang);

const isTranslationMissing = noticia.lang !== lang;

const { title, date, image, imageAlt, tags, author, resumo, content } = noticia;

// Edição visual: sem tradução, a página mostra a versão em pt, e editar dali
// sobrescreveria o português. Nesse caso a página sai sem anotações, e o corpo
// vai como cópia, que perde a marca de edição do EmDash.
const edit = isTranslationMissing ? undefined : noticia.edit;
const corpo = isTranslationMissing ? [...content] : content;
---

<BaseLayout
  lang={lang}
  titulo={title}
  descricao={resumo}
  texts={locale.texts}
  identidade={locale.identidade}
  githubPath={isPreview ? undefined : 'src/pages/[lang]/noticias/[...slug].astro'}
  naoIndexar={isPreview}
>
  {
    isTranslationMissing && (
      <TranslationWarning availableLangs={[noticia.lang]} currentLang={lang} texts={locale.texts} />
    )
  }
  <main class="container mx-auto px-4 py-12">
    <FaseTesteAlert lang={lang} area={locale.texts.header.noticias || 'Notícias'} />
    {
      isPreview && (
        <div role="status" class="alert alert-warning mb-8">
          Pré-visualização: esta versão ainda não foi publicada.
        </div>
      )
    }
    <div class="grid gap-12 lg:grid-cols-3">
      <!-- Article Content -->
      <article class="lg:col-span-2">
        <header class="mb-8">
          <div class="mb-4 flex flex-wrap gap-2">
            {
              tags.map((tag) => (
                <a
                  href={getNoticiaCategoriaUrl(tag.slug, lang)}
                  class="text-primary text-xs font-bold tracking-widest uppercase hover:underline"
                >
                  {tag.label}
                </a>
              ))
            }
          </div>

          <h1
            {...edit?.title}
            class="text-base-content mb-6 text-4xl leading-tight font-bold md:text-5xl"
          >
            {title}
          </h1>

          <p {...edit?.resumo} class="text-base-content/70 mb-8 text-xl italic">
            {resumo}
          </p>

          <div class="border-base-200 flex items-center gap-4 border-y py-6 text-sm">
            <div class="flex flex-col">
              <span class="text-base-content font-bold">
                {locale.noticias?.by || 'Por'} {author}
              </span>
              <span class="text-base-content/60">
                {locale.publicacoes?.publishedIn || 'Publicado em'}{' '}
                {formatNoticiaDate(date, lang, { day: 'numeric', month: 'long', year: 'numeric' })}
              </span>
            </div>
          </div>
        </header>

        {
          image && (
            <figure {...edit?.image} class="mb-10">
              <Image image={image} alt={imageAlt} priority class="w-full rounded-2xl shadow-lg" />
            </figure>
          )
        }

        <div
          class="prose prose-lg prose-headings:text-primary prose-headings:font-bold prose-p:text-base-content/90 prose-p:leading-relaxed prose-p:text-justify prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-img:rounded-xl prose-img:shadow-md max-w-none"
        >
          <PortableText value={corpo} />
        </div>

        <footer class="border-base-200 mt-12 border-t pt-8">
          <div class="flex flex-wrap gap-2">
            <span class="mr-2 self-center text-sm font-bold tracking-wider uppercase opacity-50"
              >{locale.noticias?.tags || 'Tags'}:</span
            >
            {
              tags.map((tag) => (
                <a
                  href={getNoticiaCategoriaUrl(tag.slug, lang)}
                  class="badge badge-outline badge-primary px-3 py-3"
                >
                  {tag.label}
                </a>
              ))
            }
          </div>
        </footer>
      </article>

      <!-- Sidebar -->
      <aside>
        <NewsSidebar noticias={noticiasDoIdioma} lang={lang} />
      </aside>
    </div>
  </main>
</BaseLayout>
